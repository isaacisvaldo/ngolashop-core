#Connection Db
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_SID=
DB_SSL=  
PORT=3003

# ==============================
# Upload — UPLOAD_MODE: local (por defeito) | s3 | supabase
# ==============================
UPLOAD_MODE=local
# URL pública da API usada nos links de ficheiros locais
API_PUBLIC_URL=http://localhost:3008/api
UPLOAD_LOCAL_DIR=uploads

# --- AWS S3 (UPLOAD_MODE=s3) ---
AWS_BUCKET=
AWS_S3_PATH=ngola-bazaar/dev/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcionais: CDN/domínio próprio e endpoint compatível (R2, MinIO)
AWS_PUBLIC_URL=
AWS_ENDPOINT=

# --- Supabase Storage (UPLOAD_MODE=supabase) ---
SUPABASE_URL=
# Service role key: só no backend, nunca nos frontends
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público
SUPABASE_BUCKET=
SUPABASE_PATH=ngola-bazaar/dev/
